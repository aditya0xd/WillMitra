{
  "name": "server",
  "version": "1.0.0",
  "description": "An application that will help manage will and testament documents for users.",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env.development --watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node --env-file=.env.production dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Digiuniv Technologies",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}